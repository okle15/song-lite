# 复制为 .env.local 后按需修改。全部可选，只有 MUSIC_DIR 真正影响功能。

# ── Next.js BFF ───────────────────────────────────────────────
# PORT=3000

# ── 音乐库根目录 ──────────────────────────────────────────────
# 不设时曲库为空（没有 mock 兜底）。
# MUSIC_DIR=/absolute/path/to/music

# ── 数据库文件位置 ────────────────────────────────────────────
# 默认 <cwd>/data/app.db；单测靠它指向临时文件。
# APP_DB_PATH=/absolute/path/to/app.db
